        <mxCell id="p2-domain-head" value="도메인 제약" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=#142B43;strokeColor=#142B43;fontColor=#FFFFFF;fontSize=20;fontStyle=1;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="64" y="691" width="811" height="48" as="geometry" /></mxCell>
        <mxCell id="p2-domain-0-title" value="식별자와 문자열" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#05726C;fontSize=15;fontStyle=1;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="79" y="750" width="781" height="23" as="geometry" /></mxCell>
        <mxCell id="p2-domain-0-body" value="모든 ID·번호는 NUMBER(10)입니다. 이름·제목은 VARCHAR2(100 CHAR), 브리핑·증거 설명·결말 본문은 VARCHAR2(500 CHAR)를 사용합니다." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#182E44;fontSize=14;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="79" y="774" width="781" height="37" as="geometry" /></mxCell>
        <mxCell id="p2-domain-1-rule" value="" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=#D2DFEB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="812" width="779" height="1" as="geometry" /></mxCell>
        <mxCell id="p2-domain-1-title" value="시간과 좌표" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#05726C;fontSize=15;fontStyle=1;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="79" y="817" width="781" height="23" as="geometry" /></mxCell>
        <mxCell id="p2-domain-1-body" value="시작·종료 시각은 TIMESTAMP(0)입니다. map_x와 map_y는 0 이상이어야 합니다." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#182E44;fontSize=14;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="79" y="841" width="781" height="29" as="geometry" /></mxCell>
        <mxCell id="p2-domain-2-rule" value="" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=#D2DFEB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="871" width="779" height="1" as="geometry" /></mxCell>
        <mxCell id="p2-domain-2-title" value="손 사용 수" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#05726C;fontSize=15;fontStyle=1;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="79" y="876" width="781" height="23" as="geometry" /></mxCell>
        <mxCell id="p2-domain-2-body" value="min_free_hands는 0·1·2만 허용합니다. original_hands는 0·1·2 또는 NULL을 허용합니다." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#182E44;fontSize=14;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="79" y="900" width="781" height="33" as="geometry" /></mxCell>
        <mxCell id="p2-domain-3-rule" value="" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=#D2DFEB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="934" width="779" height="1" as="geometry" /></mxCell>
        <mxCell id="p2-domain-3-title" value="전원과 복사 허용" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#05726C;fontSize=15;fontStyle=1;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="79" y="939" width="781" height="23" as="geometry" /></mxCell>
        <mxCell id="p2-domain-3-body" value="requires_power와 copy_allowed는 각각 Y 또는 N입니다." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#182E44;fontSize=14;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="79" y="963" width="781" height="23" as="geometry" /></mxCell>
        <mxCell id="p2-domain-4-rule" value="" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=#D2DFEB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="987" width="779" height="1" as="geometry" /></mxCell>
        <mxCell id="p2-domain-4-title" value="구역과 회차 상태" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#05726C;fontSize=15;fontStyle=1;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="79" y="992" width="781" height="23" as="geometry" /></mxCell>
        <mxCell id="p2-domain-4-body" value="area_type은 START·NORMAL·EXIT입니다. run_status는 ACTIVE·ESCAPED·FAILED입니다." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#182E44;fontSize=14;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="79" y="1016" width="781" height="29" as="geometry" /></mxCell>
        <mxCell id="p2-domain-5-rule" value="" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=#D2DFEB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1046" width="779" height="1" as="geometry" /></mxCell>
        <mxCell id="p2-domain-5-title" value="회수 형태와 결말 조건" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#05726C;fontSize=15;fontStyle=1;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="79" y="1051" width="781" height="23" as="geometry" /></mxCell>
        <mxCell id="p2-domain-5-body" value="recovery_form은 ORIGINAL 또는 COPY입니다. required_form은 ORIGINAL·COPY·ANY입니다." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#182E44;fontSize=14;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="79" y="1075" width="781" height="32" as="geometry" /></mxCell>
        <mxCell id="p2-domain-6-rule" value="" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=#D2DFEB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1108" width="779" height="1" as="geometry" /></mxCell>
        <mxCell id="p2-domain-6-title" value="결말 우선순위" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#05726C;fontSize=15;fontStyle=1;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="79" y="1113" width="781" height="23" as="geometry" /></mxCell>
        <mxCell id="p2-domain-6-body" value="ending_rank는 1–999입니다. UNIQUE (case_id, ending_rank)로 같은 사건의 동순위를 방지합니다." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#182E44;fontSize=14;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="79" y="1137" width="781" height="31" as="geometry" /></mxCell>
        <mxCell id="p2-domain-7-rule" value="" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=#D2DFEB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1169" width="779" height="1" as="geometry" /></mxCell>
        <mxCell id="p2-domain-7-title" value="빈값 허용" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#05726C;fontSize=15;fontStyle=1;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="79" y="1174" width="781" height="23" as="geometry" /></mxCell>
        <mxCell id="p2-domain-7-body" value="original_hands·ended_at·exit_area_no·ending_no만 NULL을 허용합니다. 나머지 열은 모두 NOT NULL입니다." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#182E44;fontSize=14;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="79" y="1198" width="781" height="32" as="geometry" /></mxCell>
        <mxCell id="p2-rules-bg" value="" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=#FFFFFF;strokeColor=#D2DFEB;" vertex="1" parent="1"><mxGeometry x="904" y="691" width="832" height="604" as="geometry" /></mxCell>
        <mxCell id="p2-rules-head" value="플레이와 저장 규칙" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=#142B43;strokeColor=#142B43;fontColor=#FFFFFF;fontSize=20;fontStyle=1;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="904" y="691" width="832" height="48" as="geometry" /></mxCell>
        <mxCell id="p2-rules-0-title" value="사건 범위와 복합 기본키" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#05726C;fontSize=15;fontStyle=1;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="919" y="750" width="802" height="23" as="geometry" /></mxCell>
        <mxCell id="p2-rules-0-body" value="번호는 같은 사건 안에서 구분합니다. 회차 증거의 기본키는 (case_id, run_no, evidence_no), 결말 조건의 기본키는 (case_id, ending_no, evidence_no)입니다." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#182E44;fontSize=14;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="919" y="774" width="802" height="55" as="geometry" /></mxCell>
        <mxCell id="p2-rules-1-rule" value="" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=#D2DFEB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="920" y="830" width="800" height="1" as="geometry" /></mxCell>
        <mxCell id="p2-rules-1-title" value="선택 외래키의 NULL 처리" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#05726C;fontSize=15;fontStyle=1;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="919" y="835" width="802" height="23" as="geometry" /></mxCell>
        <mxCell id="p2-rules-1-body" value="case_id는 항상 필요합니다. exit_area_no 또는 ending_no가 NULL이면 해당 참조는 생략합니다. 값이 있으면 같은 사건의 구역 또는 결말을 참조해야 합니다." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#182E44;fontSize=14;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="919" y="859" width="802" height="57" as="geometry" /></mxCell>
        <mxCell id="p2-rules-2-rule" value="" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=#D2DFEB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="920" y="917" width="800" height="1" as="geometry" /></mxCell>
        <mxCell id="p2-rules-2-title" value="통과와 회수" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#05726C;fontSize=15;fontStyle=1;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="919" y="922" width="802" height="23" as="geometry" /></mxCell>
        <mxCell id="p2-rules-2-body" value="통로는 비어 있는 손이 min_free_hands 이상이고 필요한 전원이 들어와야 통과합니다. original_hands가 NULL이면 원본 회수가 불가능하며, 복사는 copy_allowed가 Y일 때만 가능합니다." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#182E44;fontSize=14;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="919" y="946" width="802" height="69" as="geometry" /></mxCell>
        <mxCell id="p2-rules-3-rule" value="" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=#D2DFEB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="920" y="1016" width="800" height="1" as="geometry" /></mxCell>
        <mxCell id="p2-rules-3-title" value="조건은 모두 충족해야 함" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#05726C;fontSize=15;fontStyle=1;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="919" y="1021" width="802" height="23" as="geometry" /></mxCell>
        <mxCell id="p2-rules-3-body" value="결말의 모든 조건 행을 충족해야 합니다. ANY는 그 증거를 원본 또는 복사본으로 확보했다는 뜻입니다. 성립한 결말 중 ending_rank가 가장 큰 결말을 선택합니다." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#182E44;fontSize=14;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="919" y="1045" width="802" height="61" as="geometry" /></mxCell>
        <mxCell id="p2-rules-4-rule" value="" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=#D2DFEB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="920" y="1107" width="800" height="1" as="geometry" /></mxCell>
        <mxCell id="p2-rules-4-title" value="탈출 성공 시에만 회수 결과 저장" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#05726C;fontSize=15;fontStyle=1;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="919" y="1112" width="802" height="23" as="geometry" /></mxCell>
        <mxCell id="p2-rules-4-body" value="RUN_EVIDENCE는 성공적으로 탈출한 회차에만 저장합니다. 회차 종료 상태, 탈출 구역, 선택된 결말과 회수 결과를 한 트랜잭션으로 확정합니다." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#182E44;fontSize=14;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="919" y="1136" width="802" height="60" as="geometry" /></mxCell>
        <mxCell id="p2-foot-number" value="2 / 2" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=9;fontFamily=Malgun Gothic;fontSize=15;fillColor=none;strokeColor=none;fontColor=#47637B;fontSize=13;align=right;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="1630" y="1311" width="106" height="24" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
